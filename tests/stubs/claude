#!/usr/bin/env bash
# tests/stubs/claude: --version -> "${STUB_CLAUDE_VERSION:-2.1.316} (Claude Code)";
# auth status --json -> {"loggedIn": ${STUB_CLAUDE_LOGGED_IN:-true}, ...}; anything else
# (claude -p above all) is billable. P3 uses the real claude from the original PATH.
# shellcheck source=/dev/null  # the shared stub helpers
. "$(dirname -- "$0")/.stublib"
stub_env_dump claude
stub_log claude -- "$@"
if [ $# -eq 1 ] && [ "$1" = --version ]; then
  printf '%s (Claude Code)\n' "${STUB_CLAUDE_VERSION:-2.1.316}"
  exit 0
fi
if [ $# -eq 3 ] && [ "$1" = auth ] && [ "$2" = status ] && [ "$3" = --json ]; then
  printf '{"loggedIn": %s, "authMethod": "oauth_token", "apiProvider": "firstParty"}\n' "${STUB_CLAUDE_LOGGED_IN:-true}"
  exit 0
fi
stub_billable claude "$@"
