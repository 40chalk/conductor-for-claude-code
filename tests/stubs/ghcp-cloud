#!/usr/bin/env bash
# tests/stubs/ghcp-cloud: stands in for ghcp's cloud-agent wrapper (a fake install dir execs it):
# --help -> fixtures/real/ghcp/ghcp-cloud-help.txt; create [-R REPO] [--base B] - passes the task
# on stdin to `gh agent-task create -F -` on PATH (the gh stub, which is billable unless
# STUB_GH_AGENT_TASK is set), mapping gh failures to ghcp-cloud's exits (2, 11, 13, 16).
# shellcheck source=/dev/null  # the shared stub helpers
. "$(dirname -- "$0")/.stublib"
stub_env_dump ghcp-cloud
stub_log ghcp-cloud -- "$@"
case "${1-}" in -h|--help|"") cat "$STUB_FIX/real/ghcp/ghcp-cloud-help.txt"; exit 0 ;; esac
[ "$1" = create ] || { printf 'ghcp-cloud stub: only create is simulated\n' >&2; exit 1; }
shift
flags=()
while [ $# -gt 0 ]; do
  case "$1" in
    -R|--repo) flags+=(--repo "$2"); shift 2 ;;
    -b|--base) flags+=(--base "$2"); shift 2 ;;
    -) shift ;;
    *) printf 'ghcp-cloud stub: unexpected %s\n' "$1" >&2; exit 1 ;;
  esac
done
command -v gh >/dev/null 2>&1 || { printf 'ghcp-cloud: gh is not on PATH\n' >&2; exit 13; }
gh auth status >/dev/null 2>&1 || { printf 'ghcp-cloud: gh is not authenticated\n' >&2; exit 11; }
gh agent-task create -F - "${flags[@]}"
rc=$?
[ "$rc" = 0 ] || { printf 'ghcp-cloud: gh exited %s\n' "$rc" >&2; exit 2; }
printf 'ghcp-cloud: the Copilot coding agent works on GitHub and opens a pull request\n' >&2
exit 0
